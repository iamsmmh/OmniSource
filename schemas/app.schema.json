{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iamsmmh.github.io/OmniSource/schemas/app.schema.json",
  "title": "OmniSource canonical application",
  "description": "Platform-neutral application metadata. Null means the source did not publish a value.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id", "name", "developer", "description", "shortDescription", "icon", "screenshots",
    "category", "categories", "tags", "repository", "sourceType", "homepage", "documentation",
    "license", "platforms", "bundleId", "packageName", "minimumIOSVersion", "minimumAndroidVersion",
    "latestVersion", "latestBuild", "latestReleaseDate", "latestReleaseNotes", "downloadAssets",
    "versions", "status", "featured", "verified", "lastUpdated"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
    "appId": { "type": "string" },
    "name": { "type": "string", "minLength": 1 },
    "developer": { "type": "string" },
    "description": { "type": "string" },
    "shortDescription": { "type": "string" },
    "icon": { "type": ["string", "null"], "format": "uri" },
    "screenshots": { "type": "array", "items": { "type": "string", "format": "uri" } },
    "category": { "type": "string", "minLength": 1 },
    "categories": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "repository": { "type": ["string", "null"], "format": "uri" },
    "repositoryUrl": { "type": "string" },
    "sourceType": { "type": "string", "minLength": 1 },
    "homepage": { "type": ["string", "null"], "format": "uri" },
    "documentation": { "type": ["string", "null"], "format": "uri" },
    "license": { "type": ["string", "null"] },
    "platforms": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "bundleId": { "type": ["string", "null"] },
    "bundleIdentifier": { "type": ["string", "null"] },
    "packageName": { "type": ["string", "null"] },
    "minimumIOSVersion": { "type": ["string", "null"] },
    "minimumAndroidVersion": { "type": ["string", "null"] },
    "minimumOSVersion": { "type": ["string", "null"] },
    "latestVersion": { "type": "string", "minLength": 1 },
    "latestBuild": { "type": ["string", "null"] },
    "latestReleaseDate": { "type": "string", "minLength": 1 },
    "latestReleaseNotes": { "type": "string" },
    "downloadAssets": { "type": "array", "items": { "$ref": "asset.schema.json" } },
    "versions": { "type": "array", "items": { "$ref": "release.schema.json" } },
    "status": { "enum": ["active", "maintenance", "inactive", "archived", "broken", "unknown"] },
    "featured": { "type": "boolean" },
    "verified": { "type": "boolean" },
    "lastUpdated": { "type": "string" },
    "health": { "type": "object", "additionalProperties": true },
    "integrity": { "type": "object", "additionalProperties": true },
    "aliases": { "type": "array", "items": { "type": "string" } }
  }
}
