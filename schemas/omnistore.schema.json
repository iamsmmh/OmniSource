{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iamsmmh.github.io/OmniSource/schemas/omnistore.schema.json",
  "title": "OmniStore canonical apps feed",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "count", "apps"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "generatedAt": { "type": "string" },
    "count": { "type": "integer", "minimum": 0 },
    "apps": { "type": "array", "items": { "$ref": "app.schema.json" } }
  }
}
