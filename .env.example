# Copy to .env and adjust. All settings are optional; defaults are production-safe.
OMNISOURCE_ENVIRONMENT=development
OMNISOURCE_LOG_LEVEL=INFO

# Engine
OMNISOURCE_PROVIDER_TIMEOUT=3.0
OMNISOURCE_MAX_CONCURRENCY=32
OMNISOURCE_MAX_ITEMS=100

# Cache
OMNISOURCE_REDIS_URL=redis://localhost:6379/0
OMNISOURCE_CACHE_ENABLED=true
OMNISOURCE_CACHE_TTL=300

# API
OMNISOURCE_HOST=0.0.0.0
OMNISOURCE_PORT=8000
