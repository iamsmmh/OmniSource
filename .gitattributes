# Generated distribution artifacts: collapse in diffs and language statistics.
feeds/*.json linguist-generated=true
feeds/*.xml  linguist-generated=true

# Consistent text files across development platforms.
*.json text eol=lf
*.xml  text eol=lf
*.py   text eol=lf
*.sh   text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf

# Images must never receive newline conversion.
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
